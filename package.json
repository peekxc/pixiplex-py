{
	"scripts": {
		"dev": "vite demo --config demo/vite.config.js",
		"build": "bun run build:widget && bun run build:pixinet && bun run build:demo",
		"docs:api": "node scripts/generate-js-api-docs.mjs",
		"docs:api:node": "node scripts/generate-js-api-docs.mjs",
		"docs:build": "node scripts/generate-js-api-docs.mjs && mkdocs build --clean",
		"build:widget": "vite build --config vite.widget.config.js",
		"build:pixinet": "vite build --config vite.pixinet.config.js",
		"build:demo": "vite build demo --config demo/vite.config.js",
		"preview": "vite preview demo --config demo/vite.config.js",
		"test": "vitest run",
		"bench": "vitest bench --run",
		"test:js": "vitest run",
		"bench:js": "vitest bench --run"
	},
	"dependencies": {
		"@pixi/events": "^7.4.2",
		"brotli-cli": "^2.1.0",
		"d3": "^7.9.0",
		"d3-dispatch": "^3.0.1",
		"d3-fetch": "^3.0.1",
		"d3-force": "^3.0.0",
		"d3-polygon": "^3.0.1",
		"d3-scale": "^4.0.2",
		"d3-selection": "^3.0.0",
		"jsdoc2md": "^1.0.0",
		"lodash-es": "^4.17.21",
		"pixi-viewport": "^6.0.3",
		"pixi.js": "^8.6.6",
		"pnpm": "^10.33.0",
		"pyodide": "^0.27.2"
	},
	"devDependencies": {
		"@unocss/preset-wind4": "^66.5.4",
		"@unocss/vite": "^66.5.4",
		"jsdoc-to-markdown": "^9.1.1",
		"unocss": "^66.5.4",
		"vite": "^7.1.3",
		"vite-bundle-analyzer": "^1.3.6",
		"vitest": "^3.2.4"
	},
	"type": "module",
	"packageManager": "bun@1.1.24"
}
