{{>main}}

{{#*inline "type"}}{{#if type}}{{#if type.names}}{{#each type.names}}{{#unless @first}} | {{/unless}}{{this}}{{/each}}{{else}}{{type}}{{/if}}{{else}}any{{/if}}{{/inline}}

{{#*inline "main"}}
{{!-- <p>Testing:  {{this.name}}</p> --}}

{{#functions}}
{{>doc-item kind="function" item=this}}
{{/functions}}


{{#classes}}
{{>doc-item kind="class" item=this}}
{{#if this.members}}
	{{#each this.members}}
		{{>doc-item kind="method" item=this}}
	{{/each}}
{{/if}}
{{/classes}}

{{/inline}}

{{#*inline "doc-item"}}
## {{item.name}} {#{{item.name}} }
<p class="mkapi-object mkapi-page-source" id={{item.name}}>
<span class="mkapi-object-kind">{{kind}}</span> <span class="mkapi-object-name">{{item.name}}</span>(
	{{#if item.params}}
	{{#each item.params}}{{#unless @first}}, {{/unless}}
	<span class="mkapi-arg">{{name}}</span>: <span class="mkapi-ann">{{>type}}</span>{{#if defaultvalue}} = <span class="mkapi-default">{{defaultvalue}}</span>{{/if}}
	{{/each}}
	{{/if}})
	{{#if item.returns}} -> 
		{{#each item.returns}}
			<span class="mkapi-ann">{{>type}}</span>
		{{/each}}
	{{/if}}
</p>
{{#if item.description}}
<div class="mkapi-document"> 
	<p>{{item.description}}</p>
	{{#if item.params}}
		<p class="mkapi-section"> 
		<span class="mkapi-object-link">
			<span class="mkapi-section-toggle" title="Toggle methods">
				<i class="fa-regular fa-square-minus"></i>
			</span>
		</span>
		<span class="mkapi-section-name">Parameters:</span>
		<div class="mkapi-section-content">
		<ul class="mkapi-item-list">
		{{#each item.params}}
			<li> <span class="mkapi-item-name mkapi-arg">{{name}}</span> <span class="mkapi-dash">—</span> {{#if description}}{{description}}{{/if}} </li>
		{{/each}}
		</ul>
		</div>
		</p>
	{{/if}}
</div>
{{/if}}
{{/inline}}
